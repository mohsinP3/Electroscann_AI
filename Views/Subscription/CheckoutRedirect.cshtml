@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <h3>Redirecting to payment...</h3>
    <p>If you are not redirected automatically, <a id="checkout-link" href="#">click here</a>.</p>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    (function(){
        const publishableKey = '@ViewBag.StripePublishableKey';
        const sessionId = '@ViewBag.SessionId';
        if (!publishableKey || !sessionId) return;
        const stripe = Stripe(publishableKey);
        stripe.redirectToCheckout({ sessionId: sessionId }).then(function (result) {
            const link = document.getElementById('checkout-link');
            if (link) link.href = '#';
        });
    })();
</script>
