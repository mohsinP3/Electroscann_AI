@using ElectroScanAI.Models.Enums
@{
    ViewData["Title"] = "My Plan & Subscriptions";
    var activeSub = ViewBag.ActiveSubscription as ElectroScanAI.Models.Entities.Subscription;
    var currentPlanName = activeSub != null && activeSub.IsActive ? activeSub.Plan.ToString() : "Free";
}

<style>
    .sub-hero {
        background: radial-gradient(120% 80% at 50% -10%, rgba(31, 138, 107, 0.12) 0%, rgba(255, 255, 255, 0) 70%), #0B2B26;
        color: #FFFFFF;
        padding: 65px 0 50px;
        border-radius: 0 0 32px 32px;
        margin-bottom: 40px;
    }

    .sub-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(107, 203, 158, 0.15);
        color: #6BCB9E;
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .plan-card {
        background: #FFFFFF;
        border: 2px solid #E2EFE9;
        border-radius: 24px;
        padding: 32px;
        transition: all 250ms ease;
        position: relative;
        overflow: hidden;
    }

    .plan-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(11, 43, 38, 0.08);
    }

    .plan-card.featured {
        border-color: #1F8A6B;
        box-shadow: 0 12px 28px rgba(31, 138, 107, 0.15);
    }

    .featured-ribbon {
        position: absolute;
        top: 20px;
        right: -35px;
        transform: rotate(45deg);
        background: #1F8A6B;
        color: white;
        padding: 4px 40px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .plan-price {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2.8rem;
        font-weight: 800;
        color: #0B2B26;
    }

    .plan-price span {
        font-size: 1rem;
        color: #6c757d;
        font-weight: 500;
    }

    .feature-list {
        list-style: none;
        padding: 0;
        margin: 24px 0 32px;
    }

    .feature-list li {
        padding: 8px 0;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #2c3e50;
        font-size: 0.95rem;
    }

    .feature-list li i {
        color: #1F8A6B;
    }

    .feature-list li.disabled {
        color: #a0aec0;
    }

    .feature-list li.disabled i {
        color: #cbd5e0;
    }
</style>

<div class="sub-hero text-center">
    <div class="container">
        <div class="sub-badge mb-3">
            <i class="fas fa-crown"></i> MEMEBER SUBSCRIPTION MANAGEMENT
        </div>
        <h1 class="fw-bold mb-3 display-5">My Plan &amp; Billing</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 650px;">
            Unlock advanced AI panel scanner, live monitoring, unlimited load calculations, and exportable engineering compliance reports.
        </p>
    </div>
</div>

<div class="container mb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Current Subscription Status -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5" style="background: linear-gradient(135deg, #0B2B26 0%, #163E38 100%); color: #FFFFFF;">
        <div class="row align-items-center">
            <div class="col-md-8 mb-3 mb-md-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background: rgba(107, 203, 158, 0.2); width:60px; height:60px;">
                        <i class="fas fa-crown fa-2x text-mint" style="color:#6BCB9E;"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-white-50 text-uppercase small fw-bold">Current Plan</span>
                            <span class="badge rounded-pill px-3 py-1" style="background: #1F8A6B; color: #fff;">
                                @currentPlanName Tier
                            </span>
                        </div>
                        <h3 class="fw-bold text-white m-0 mt-1">
                            @(activeSub != null && activeSub.IsActive ? $"{activeSub.Plan} Membership" : "Free Plan")
                        </h3>
                        <p class="text-white-50 small m-0 mt-1">
                            @if (activeSub != null && activeSub.IsActive)
                            {
                                <span><i class="fas fa-calendar-alt me-1 text-mint"></i> Active until @activeSub.EndDate.ToLocalTime().ToString("D")</span>
                            }
                            else
                            {
                                <span>Basic features access • Upgrade anytime for full AI scanning suite</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                @if (activeSub != null && activeSub.IsActive)
                {
                    <form asp-action="CancelSubscription" asp-controller="Subscription" method="post" onsubmit="return confirm('Are you sure you want to cancel your paid subscription? You will return to the Free tier.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light rounded-3 px-4 py-2">
                            <i class="fas fa-times-circle me-2"></i> Cancel Subscription
                        </button>
                    </form>
                }
                else
                {
                    <a href="#plansSection" class="btn px-4 py-2 rounded-3 text-dark fw-bold" style="background:#6BCB9E;">
                        <i class="fas fa-arrow-up me-2"></i> Upgrade Now
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Plans & Feature Comparison -->
    <div id="plansSection" class="row g-4 mb-5">
        <!-- Free Plan -->
        <div class="col-lg-4">
            <div class="plan-card h-100 d-flex flex-column">
                <div>
                    <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill fw-bold text-uppercase small">Starter</span>
                    <h3 class="fw-bold text-dark mt-3 mb-1">Free Tier</h3>
                    <p class="text-muted small">Essential tools for DIY home inspections</p>
                    <div class="plan-price my-3">$0 <span>/ month</span></div>
                </div>

                <ul class="feature-list flex-grow-1">
                    <li><i class="fas fa-check-circle"></i> 5 Wire Color Scans / Month</li>
                    <li><i class="fas fa-check-circle"></i> Basic Load Calculator</li>
                    <li><i class="fas fa-check-circle"></i> Public Market Rates Access</li>
                    <li class="disabled"><i class="fas fa-times-circle"></i> AI Thermal Vision Scanner</li>
                    <li class="disabled"><i class="fas fa-times-circle"></i> Export PDF Estimates</li>
                    <li class="disabled"><i class="fas fa-times-circle"></i> 24/7 Live Monitoring</li>
                </ul>

                <div>
                    @if (currentPlanName == "Free")
                    {
                        <button class="btn btn-secondary w-full py-3 rounded-3 fw-bold disabled w-100" disabled>
                            Current Plan
                        </button>
                    }
                    else
                    {
                        <form asp-action="CancelSubscription" asp-controller="Subscription" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary w-100 py-3 rounded-3 fw-bold">
                                Switch to Free
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Pro Plan -->
        <div class="col-lg-4">
            <div class="plan-card featured h-100 d-flex flex-column">
                <div class="featured-ribbon">POPULAR</div>
                <div>
                    <span class="badge bg-emerald-subtle text-emerald px-3 py-2 rounded-pill fw-bold text-uppercase small">Electricians</span>
                    <h3 class="fw-bold text-dark mt-3 mb-1">Pro Plan</h3>
                    <p class="text-muted small">Full suite for certified technicians</p>
                    <div class="plan-price my-3">$79 <span>/ month</span></div>
                </div>

                <ul class="feature-list flex-grow-1">
                    <li><i class="fas fa-check-circle"></i> Unlimited AI Wire Scans</li>
                    <li><i class="fas fa-check-circle"></i> Full Thermal Vision Inspection</li>
                    <li><i class="fas fa-check-circle"></i> Unlimited Load Calculations</li>
                    <li><i class="fas fa-check-circle"></i> PDF Estimate &amp; Report Export</li>
                    <li><i class="fas fa-check-circle"></i> Client Job Bidding Access</li>
                    <li class="disabled"><i class="fas fa-times-circle"></i> Multi-User Team Accounts</li>
                </ul>

                <div>
                    @if (currentPlanName == "Pro")
                    {
                        <button class="btn btn-success w-100 py-3 rounded-3 fw-bold disabled" disabled>
                            <i class="fas fa-check me-2"></i> Active Subscription
                        </button>
                    }
                    else
                    {
                        <form asp-action="Create" asp-controller="Subscription" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="@SubscriptionPlan.Pro" />
                            <button type="submit" class="btn btn-success w-100 py-3 rounded-3 fw-bold shadow-sm" style="background:#1F8A6B; border:none;">
                                <i class="fas fa-bolt me-2"></i> Upgrade to Pro ($79)
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Enterprise Plan -->
        <div class="col-lg-4">
            <div class="plan-card h-100 d-flex flex-column">
                <div>
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-uppercase small">Companies</span>
                    <h3 class="fw-bold text-dark mt-3 mb-1">Enterprise</h3>
                    <p class="text-muted small">Complete platform for contractor firms</p>
                    <div class="plan-price my-3">$199 <span>/ month</span></div>
                </div>

                <ul class="feature-list flex-grow-1">
                    <li><i class="fas fa-check-circle"></i> Everything in Pro Plan</li>
                    <li><i class="fas fa-check-circle"></i> Multi-User Team Accounts (Up to 25)</li>
                    <li><i class="fas fa-check-circle"></i> Custom Company Branding on Reports</li>
                    <li><i class="fas fa-check-circle"></i> Dedicated Account Manager</li>
                    <li><i class="fas fa-check-circle"></i> Priority 24/7 Support</li>
                    <li><i class="fas fa-check-circle"></i> REST API Access</li>
                </ul>

                <div>
                    @if (currentPlanName == "Enterprise")
                    {
                        <button class="btn btn-primary w-100 py-3 rounded-3 fw-bold disabled" disabled>
                            <i class="fas fa-check me-2"></i> Active Subscription
                        </button>
                    }
                    else
                    {
                        <form asp-action="Create" asp-controller="Subscription" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="@SubscriptionPlan.Enterprise" />
                            <button type="submit" class="btn btn-dark w-100 py-3 rounded-3 fw-bold shadow-sm">
                                <i class="fas fa-building me-2"></i> Upgrade to Enterprise ($199)
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
