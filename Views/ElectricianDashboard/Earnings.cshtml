@model List<ElectroScanAI.Models.Entities.Payment>
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "My Earnings";
    ViewBag.PageTitle = "My Earnings";
    ViewBag.ActivePage = "Earnings";
    decimal totalEarnings = ViewBag.TotalEarnings ?? 0m;
}

<div class="page-header">
    <h1>My Earnings</h1>
    <p>Track your income and payment history</p>
</div>

<!-- Stats -->
<div class="stats-grid" style="grid-template-columns: repeat(2, 1fr);">
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-wallet"></i></div>
        <div class="stat-value">PKR @totalEarnings.ToString("N0")</div>
        <div class="stat-label">Total Earnings</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-check-double"></i></div>
        <div class="stat-value">@(Model?.Count ?? 0)</div>
        <div class="stat-label">Payments Received</div>
    </div>
</div>

<!-- Payment History -->
<div class="table-card">
    <div class="table-card-header">
        <div class="table-card-title"><i class="fas fa-history"></i> Payment History (@(Model?.Count ?? 0))</div>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Transaction ID</th>
                <th>Date</th>
                <th>Method</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="font-family:monospace;">#@p.TransactionId</td>
                        <td>@p.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@p.PaymentMethod</td>
                        <td class="fw-bold text-success">PKR @p.Amount.ToString("N0")</td>
                        <td><span class="badge badge-green"><i class="fas fa-check-circle me-1"></i> @p.Status</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        <i class="fas fa-wallet fa-3x mb-3 text-secondary d-block"></i>
                        No payment records yet. Complete jobs to start earning!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
