@model List<ElectroScanAI.Models.Entities.Job>
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Available Jobs";
    ViewBag.PageTitle = "Available Jobs";
    ViewBag.ActivePage = "AvailableJobs";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="fw-bold m-0"><i class="fas fa-briefcase text-emerald me-2"></i> Available Electrical Jobs</h1>
        <p class="text-muted mt-1 m-0">Browse and apply to verified electrical jobs and contract postings in your region</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-emerald-subtle text-emerald px-3 py-2 rounded-pill fw-bold">
            <i class="fas fa-shield-alt me-1"></i> Verified Postings
        </span>
    </div>
</div>

<!-- Filters Bar -->
<div class="table-card p-3 mb-4">
    <form method="get" asp-action="AvailableJobs" class="row g-2 align-items-center">
        <div class="col-md-7 col-lg-8">
            <div class="position-relative">
                <i class="fas fa-search text-muted position-absolute" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 0.9rem;"></i>
                <input type="text" name="search" class="form-control rounded-pill ps-5 border-light-subtle shadow-none" value="@Context.Request.Query["search"]" placeholder="Search by job title, electrical skills, or keyword...">
            </div>
        </div>
        <div class="col-md-3 col-lg-2">
            <div class="position-relative">
                <i class="fas fa-map-marker-alt text-muted position-absolute" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 0.9rem;"></i>
                <input type="text" name="location" class="form-control rounded-pill ps-5 border-light-subtle shadow-none" value="@Context.Request.Query["location"]" placeholder="City / Region">
            </div>
        </div>
        <div class="col-md-2 col-lg-2">
            <button type="submit" class="btn btn-emerald w-100 rounded-pill fw-bold">
                <i class="fas fa-filter me-1"></i> Search
            </button>
        </div>
    </form>
</div>

<!-- Jobs List -->
<div class="d-flex flex-column gap-3 mb-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var job in Model)
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 transition-all hover-elevation" style="border: 1px solid #E2ECE8 !important;">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <h4 class="fw-bold text-dark m-0">@job.Title</h4>
                            <span class="badge bg-success-subtle text-emerald px-3 py-2 rounded-pill fw-bold">
                                <i class="fas fa-building me-1"></i> @(job.Company?.CompanyName ?? "Direct Client")
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-3 text-muted small mt-2">
                            <span><i class="fas fa-map-marker-alt text-danger me-1"></i> @job.Location</span>
                            <span><i class="fas fa-calendar-alt text-primary me-1"></i> Posted @job.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-emerald text-white fs-6 px-3 py-2 rounded-pill shadow-sm">
                            <i class="fas fa-coins me-1 text-warning"></i> PKR @job.Budget.ToString("N0")
                        </span>
                    </div>
                </div>

                <p class="text-secondary mb-3 leading-relaxed" style="max-width: 860px;">@job.Description</p>

                <div class="p-3 bg-light rounded-3 border-light d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <form asp-action="ApplyForJob" method="post" class="d-flex gap-2 align-items-center w-100 flex-wrap">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" value="@job.Id" />
                        <div class="flex-grow-1" style="min-width: 240px;">
                            <input type="text" name="coverLetter" class="form-control form-control-sm rounded-pill px-3" placeholder="Add an optional bid note or cover letter..." />
                        </div>
                        <button type="submit" class="btn btn-emerald btn-sm rounded-pill fw-bold px-4 py-2">
                            <i class="fas fa-paper-plane me-1"></i> Apply Now
                        </button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white" style="border: 1px solid #E2ECE8 !important;">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-4 text-emerald">
                    <i class="fas fa-briefcase fa-3x"></i>
                </div>
            </div>
            <h5 class="fw-bold text-dark mb-1">No Available Jobs Found</h5>
            <p class="text-muted max-w-md mx-auto mb-3">There are currently no open electrical job listings matching your search filter. Check back soon for new contract opportunities!</p>
            <div>
                <a asp-action="AvailableJobs" class="btn btn-outline-dark rounded-pill px-4 fw-bold btn-sm">
                    <i class="fas fa-sync-alt me-1"></i> Reset Filters
                </a>
            </div>
        </div>
    }
</div>
