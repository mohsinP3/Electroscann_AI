@model List<ElectroScanAI.Models.Entities.JobApplication>
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Applied Jobs";
    ViewBag.PageTitle = "Applied Jobs";
    ViewBag.ActivePage = "AppliedJobs";

    int totalApplied = Model?.Count ?? 0;
    int pending = Model?.Count(a => a.Status == "Pending") ?? 0;
    int accepted = Model?.Count(a => a.Status == "Accepted") ?? 0;
    int rejected = Model?.Count(a => a.Status == "Rejected") ?? 0;
}

<div class="page-header">
    <h1>Applied Jobs</h1>
    <p>Track the status of your job applications</p>
</div>

<!-- Status Summary -->
<div class="stats-grid" style="grid-template-columns: repeat(4, 1fr);">
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-paper-plane"></i></div>
        <div class="stat-value">@totalApplied</div>
        <div class="stat-label">Total Applied</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
        <div class="stat-value">@pending</div>
        <div class="stat-label">Under Review</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
        <div class="stat-value">@accepted</div>
        <div class="stat-label">Accepted</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-times-circle"></i></div>
        <div class="stat-value">@rejected</div>
        <div class="stat-label">Rejected</div>
    </div>
</div>

<!-- Applications Table -->
<div class="table-card">
    <div class="table-card-header">
        <div class="table-card-title"><i class="fas fa-file-alt"></i> My Applications (@totalApplied)</div>
        <a asp-action="AvailableJobs" asp-controller="ElectricianDashboard" class="btn-primary-dash">
            <i class="fas fa-plus"></i> Apply to More Jobs
        </a>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>App ID</th>
                <th>Job Title</th>
                <th>Company</th>
                <th>Location</th>
                <th>Applied Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var app in Model)
                {
                    <tr>
                        <td style="font-family:monospace;">#APP-@app.Id.ToString("D3")</td>
                        <td class="fw-bold">@app.Job?.Title</td>
                        <td>@(app.Job?.Company?.CompanyName ?? "Direct Client")</td>
                        <td>@app.Job?.Location</td>
                        <td>@app.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (app.Status == "Accepted")
                            {
                                <span class="badge badge-green"><i class="fas fa-check-circle me-1"></i> Accepted</span>
                            }
                            else if (app.Status == "Rejected")
                            {
                                <span class="badge badge-red"><i class="fas fa-times-circle me-1"></i> Rejected</span>
                            }
                            else
                            {
                                <span class="badge badge-yellow"><i class="fas fa-clock me-1"></i> Under Review</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-5">
                        <i class="fas fa-paper-plane fa-3x mb-3 text-secondary d-block"></i>
                        You have not applied for any jobs yet. Check out Available Jobs to apply!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
