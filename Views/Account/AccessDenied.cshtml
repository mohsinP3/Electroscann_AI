@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter',sans-serif;
                background:
                    radial-gradient(circle at top left, rgba(107, 203, 158, 0.16), transparent 22%),
                    linear-gradient(135deg, #0B2B26 0%, #0f3b33 55%, #11463c 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
            }

            .card {
                background: linear-gradient(180deg, rgba(255,255,255,0.97), rgba(248,251,250,0.97));
                border-radius: 32px;
                padding: 48px;
                text-align: center;
                max-width: 470px;
                box-shadow: 0 24px 60px rgba(2, 20, 16, 0.24);
                border: 1px solid rgba(255,255,255,0.55);
            }

            .btn-home {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #1F8A6B, #2ea882 58%, #6BCB9E);
                color: white;
                border: none;
                padding: 12px 24px;
                border-radius: 999px;
                margin-top: 24px;
                cursor: pointer;
                text-decoration: none;
                font-weight: 700;
                box-shadow: 0 10px 24px rgba(31,138,107,0.24);
            }
    </style>
</head>
<body>   
    <div class="card"><i class="fas fa-lock" style="font-size:4rem;color:#EF4444;margin-bottom:20px;"></i><h1>Access Denied</h1><p>You don't have permission to access this page.</p><a href="/" class="btn-home">Return to Home</a></div>
</body>
</html>