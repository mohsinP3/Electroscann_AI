@{
    ViewData["Title"] = "Contact Us | ElectroScan AI";
}

<style>
    /* ==========================================================================
       CONTACT PAGE - PREMIUM SAAS STYLES
       ========================================================================== */
    .es-contact-page {
        --es-pine: #0B2B26;
        --es-forest: #0F3B33;
        --es-emerald: #1F8A6B;
        --es-mint: #6BCB9E;
        --es-bright-mint: #00D68F;
        --es-orange: #FF7A00;
        --es-light-bg: #F8FAF9;
        --es-card-bg: #FFFFFF;
        --es-border: #E2EFE9;
        --es-text-main: #0F221E;
        --es-text-muted: #4A635B;
        --es-font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
        --es-font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-family: var(--es-font-body);
        color: var(--es-text-main);
    }

    /* Hero Section */
    .contact-hero {
        position: relative;
        padding: 85px 0 55px;
        background: radial-gradient(120% 80% at 50% -10%, rgba(31, 138, 107, 0.12) 0%, rgba(255, 255, 255, 0) 70%), #FFFFFF;
        text-align: center;
        overflow: hidden;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(31, 138, 107, 0.08);
        border: 1px solid rgba(31, 138, 107, 0.22);
        color: var(--es-emerald);
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .contact-hero h1 {
        font-family: var(--es-font-heading);
        font-size: clamp(2.4rem, 4.5vw, 3.6rem);
        font-weight: 800;
        color: var(--es-pine);
        margin: 0 auto 18px auto;
        line-height: 1.2;
        max-width: 820px;
    }

    .contact-hero h1 .highlight {
        background: linear-gradient(135deg, var(--es-emerald) 0%, #11503E 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .contact-hero p {
        font-size: 1.15rem;
        color: var(--es-text-muted);
        max-width: 640px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* Contact Main Grid */
    .contact-main {
        padding: 40px 0 80px;
    }

    .contact-layout {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 40px;
        align-items: start;
    }

    /* Form Card */
    .contact-form-card {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 8px 24px rgba(11, 43, 38, 0.04);
        transition: all 220ms ease;
    }

    .contact-form-card h2 {
        font-family: var(--es-font-heading);
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--es-pine);
        margin-bottom: 6px;
    }

    .form-subtitle {
        color: var(--es-text-muted);
        font-size: 0.95rem;
        margin-bottom: 28px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 13px 18px;
        border: 1px solid var(--es-border);
        border-radius: 12px;
        font-size: 0.95rem;
        color: var(--es-text-main);
        background-color: var(--es-light-bg);
        outline: none;
        transition: all 180ms ease;
        font-family: var(--es-font-body);
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: var(--es-emerald);
        background-color: #FFFFFF;
        box-shadow: 0 0 0 3px rgba(31, 138, 107, 0.12);
    }

    .btn-full {
        width: 100%;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: linear-gradient(135deg, var(--es-emerald) 0%, #166A52 100%);
        color: #FFFFFF !important;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.98rem;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(31, 138, 107, 0.25);
        transition: all 200ms ease;
        text-decoration: none !important;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #166A52 0%, #0F3B33 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(31, 138, 107, 0.35);
    }

    /* Contact Info Cards Sidebar */
    .contact-info-cards {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .contact-info-card {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        gap: 18px;
        align-items: flex-start;
        box-shadow: 0 6px 20px rgba(11, 43, 38, 0.03);
        transition: all 200ms ease;
    }

    .contact-info-card:hover {
        transform: translateY(-4px);
        border-color: var(--es-emerald);
        box-shadow: 0 12px 28px rgba(31, 138, 107, 0.12);
    }

    .info-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(31, 138, 107, 0.08);
        color: var(--es-emerald);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .info-content h4 {
        font-family: var(--es-font-heading);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--es-pine);
        margin: 0 0 6px;
    }

    .info-content p {
        font-size: 0.92rem;
        color: var(--es-text-muted);
        margin: 0;
        line-height: 1.5;
    }

    .info-content a {
        color: var(--es-emerald);
        text-decoration: none;
        font-weight: 600;
        transition: color 150ms ease;
    }

    .info-content a:hover {
        color: var(--es-pine);
        text-decoration: underline;
    }

    .info-hours {
        font-size: 0.82rem;
        color: var(--es-text-muted);
        margin-top: 4px !important;
    }

    .online-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(0, 214, 143, 0.12);
        color: #00A36C;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        margin-top: 8px;
    }

    .online-badge i {
        font-size: 0.5rem;
    }

    /* Map Section */
    .map-section {
        padding: 0 0 80px;
    }

    .map-wrapper {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(11, 43, 38, 0.04);
    }

    .map-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 32px;
        border-bottom: 1px solid var(--es-border);
        background: var(--es-light-bg);
        flex-wrap: wrap;
        gap: 16px;
    }

    .map-header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .map-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(31, 138, 107, 0.1);
        color: var(--es-emerald);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .map-header-text h3 {
        font-family: var(--es-font-heading);
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--es-pine);
        margin: 0 0 2px;
    }

    .map-header-text p {
        font-size: 0.88rem;
        color: var(--es-text-muted);
        margin: 0;
    }

    .map-direction-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #FFFFFF;
        color: var(--es-pine);
        border: 1px solid var(--es-border);
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.88rem;
        text-decoration: none;
        transition: all 180ms ease;
    }

    .map-direction-btn:hover {
        border-color: var(--es-emerald);
        color: var(--es-emerald);
        transform: translateY(-2px);
    }

    .map-container {
        position: relative;
        height: 380px;
        width: 100%;
        background: #EAEAEA;
    }

    .map-container iframe {
        width: 100%;
        height: 100%;
        border: none;
    }

    .map-fallback {
        display: none;
        position: absolute;
        inset: 0;
        background: var(--es-light-bg);
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: var(--es-text-muted);
        text-align: center;
        padding: 20px;
    }

    .map-status {
        position: absolute;
        bottom: 20px;
        left: 20px;
        background: #FFFFFF;
        padding: 10px 18px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid var(--es-border);
    }

    .status-dot {
        width: 10px;
        height: 10px;
        background-color: var(--es-bright-mint);
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(0, 214, 143, 0.2);
    }

    .status-text {
        font-weight: 700;
        font-size: 0.88rem;
        color: var(--es-pine);
        display: flex;
        flex-direction: column;
    }

    .status-text span {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--es-text-muted);
    }

    /* FAQ Section */
    .faq-section {
        padding: 20px 0 80px;
    }

    .section-tag {
        display: inline-block;
        color: var(--es-emerald);
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .section-header h2 {
        font-family: var(--es-font-heading);
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--es-pine);
        margin-bottom: 40px;
    }

    .faq-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .faq-item {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 6px 20px rgba(11, 43, 38, 0.03);
        transition: all 200ms ease;
    }

    .faq-item:hover {
        transform: translateY(-4px);
        border-color: var(--es-emerald);
        box-shadow: 0 12px 28px rgba(31, 138, 107, 0.1);
    }

    .faq-item h4 {
        font-family: var(--es-font-heading);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--es-pine);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .faq-item h4 i {
        color: var(--es-emerald);
    }

    .faq-item p {
        font-size: 0.92rem;
        color: var(--es-text-muted);
        line-height: 1.6;
        margin: 0;
    }

    /* CTA Section */
    .cta-section {
        background: linear-gradient(135deg, var(--es-pine) 0%, var(--es-forest) 100%);
        padding: 70px 0;
        border-radius: 28px;
        color: #FFFFFF;
        text-align: center;
        margin-bottom: 80px;
    }

    .cta-content h2 {
        font-family: var(--es-font-heading);
        font-size: 2.2rem;
        font-weight: 800;
        color: #FFFFFF;
        margin-bottom: 12px;
    }

    .cta-content p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.08rem;
        max-width: 580px;
        margin: 0 auto 32px;
    }

    .cta-actions {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .btn-light {
        background: #FFFFFF !important;
        color: var(--es-pine) !important;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }

    .btn-light:hover {
        background: var(--es-mint) !important;
        color: var(--es-pine) !important;
    }

    .btn-outline-light {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        color: #FFFFFF !important;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.98rem;
        text-decoration: none !important;
        transition: all 200ms ease;
    }

    .btn-outline-light:hover {
        border-color: #FFFFFF;
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }

    @@media (max-width: 991px) {
        .contact-layout {
            grid-template-columns: 1fr;
        }
        .faq-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="es-contact-page">
    <!-- Contact Hero -->
    <div class="contact-hero">
        <div class="container">
            <div class="contact-hero-content reveal">
                <div class="hero-badge">
                    <i class="fas fa-comment-dots"></i>
                    GET IN TOUCH
                </div>
                <h1>Let's talk about <span class="highlight">electrical safety</span></h1>
                <p>
                    Have questions about AI-powered inspections? Need a demo? Our team is ready to help 
                    you build a smarter, safer electrical workflow.
                </p>
            </div>
        </div>
    </div>

    <!-- Contact Grid -->
    <div class="contact-main">
        <div class="container">
            <div class="contact-layout">
                <!-- Form -->
                <div class="contact-form-card reveal">
                    <h2>Send us a message</h2>
                    <p class="form-subtitle">We'll reply within 24 hours.</p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; font-weight: 500;">
                            <i class="fas fa-check-circle fs-5"></i>
                            <div>@TempData["Success"]</div>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; font-weight: 500;">
                            <i class="fas fa-exclamation-triangle fs-5"></i>
                            <div>@TempData["Error"]</div>
                        </div>
                    }

                    <div id="contactFormAlert" class="alert d-none align-items-center gap-2 mb-4" style="border-radius: 12px; font-weight: 500;"></div>

                    <form id="contactFormAction" action="/Home/Contact" method="post">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="fullName" class="form-label text-muted small mb-1 fw-bold">Full Name <span class="text-danger">*</span></label>
                                <input type="text" id="fullName" name="Name" placeholder="e.g. John Doe" required />
                            </div>
                            <div class="form-group">
                                <label for="emailAddress" class="form-label text-muted small mb-1 fw-bold">Email Address <span class="text-danger">*</span></label>
                                <input type="email" id="emailAddress" name="Email" placeholder="e.g. john@example.com" required />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="phoneNumber" class="form-label text-muted small mb-1 fw-bold">Phone Number</label>
                                <input type="tel" id="phoneNumber" name="Phone" placeholder="e.g. +1 (555) 000-0000" />
                            </div>
                            <div class="form-group">
                                <label for="companyName" class="form-label text-muted small mb-1 fw-bold">Company / Organization</label>
                                <input type="text" id="companyName" name="Company" placeholder="e.g. Acme Electric Corp" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="subjectLine" class="form-label text-muted small mb-1 fw-bold">Subject <span class="text-danger">*</span></label>
                            <input type="text" id="subjectLine" name="Subject" placeholder="e.g. AI Inspection Inquiry / Demo Request" required />
                        </div>
                        <div class="form-group">
                            <label for="messageContent" class="form-label text-muted small mb-1 fw-bold">Message <span class="text-danger">*</span></label>
                            <textarea rows="5" id="messageContent" name="Message" placeholder="Tell us about your project or question..." required></textarea>
                        </div>
                        <button type="submit" id="contactSubmitBtn" class="btn-primary btn-full">
                            <i class="fas fa-paper-plane"></i>
                            Send Message
                        </button>
                    </form>
                </div>

                <!-- Info Cards -->
                <div class="contact-info-cards">
                    <div class="contact-info-card reveal">
                        <div class="info-icon"><i class="fas fa-map-marker-alt"></i></div>
                        <div class="info-content">
                            <h4>Visit our HQ</h4>
                            <p>123 Powertech Drive<br />Suite 400, Houston, TX 77024<br />United States</p>
                        </div>
                    </div>
                    <div class="contact-info-card reveal" style="transition-delay: 0.1s;">
                        <div class="info-icon"><i class="fas fa-phone-alt"></i></div>
                        <div class="info-content">
                            <h4>Call us directly</h4>
                            <p><a href="tel:+15226056148">+1 (522) 605-6148</a></p>
                            <p class="info-hours">Mon–Fri, 9am – 6pm CST</p>
                        </div>
                    </div>
                    <div class="contact-info-card reveal" style="transition-delay: 0.2s;">
                        <div class="info-icon"><i class="fas fa-envelope"></i></div>
                        <div class="info-content">
                            <h4>Email support</h4>
                            <p><a href="mailto:hello@electroscanai.com">hello@electroscanai.com</a></p>
                            <p><a href="mailto:support@electroscanai.com">support@electroscanai.com</a></p>
                        </div>
                    </div>
                    <div class="contact-info-card reveal" style="transition-delay: 0.3s;">
                        <div class="info-icon"><i class="fas fa-comment-dots"></i></div>
                        <div class="info-content">
                            <h4>Live chat</h4>
                            <p>Chat with our team now</p>
                            <span class="online-badge">
                                <i class="fas fa-circle"></i>
                                We're online
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <div class="map-section">
        <div class="container">
            <div class="map-wrapper reveal">
                <div class="map-header">
                    <div class="map-header-left">
                        <div class="map-icon"><i class="fas fa-location-dot"></i></div>
                        <div class="map-header-text">
                            <h3>ElectroScan AI Headquarters</h3>
                            <p>123 Powertech Drive, Suite 400, Houston, TX 77024</p>
                        </div>
                    </div>
                    <a href="https://www.google.com/maps/dir//123+Powertech+Dr,+Houston,+TX+77024" 
                       target="_blank" rel="noopener" class="map-direction-btn">
                        <i class="fas fa-diamond-turn-right"></i>
                        Get Directions
                    </a>
                </div>

                <div class="map-container" id="mapBox">
                    <iframe id="mapIframe"
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3465.234!2d-95.5585!3d29.7754!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8640c5e5a5e5e5e5%3A0x5e5e5e5e5e5e5e5e!2sHouston%2C%20TX%2077024!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title="ElectroScan AI Office Location Map"></iframe>

                    <div class="map-fallback" id="mapFallback">
                        <i class="fas fa-map-location-dot"></i>
                        <p>Map couldn't load in this browser</p>
                        <a href="https://www.google.com/maps/place/Houston,+TX+77024" target="_blank" rel="noopener">
                            Open in Google Maps <i class="fas fa-external-link-alt"></i>
                        </a>
                    </div>

                    <div class="map-status">
                        <div class="status-dot" id="statusDot"></div>
                        <div class="status-text" id="statusText">
                            Office Open
                            <span>Mon–Fri, 9am – 6pm CST</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FAQ -->
    <div class="faq-section">
        <div class="container">
            <div class="section-header text-center reveal">
                <span class="section-tag">FAQ</span>
                <h2>Frequently asked questions</h2>
            </div>
            <div class="faq-grid">
                <div class="faq-item reveal">
                    <h4><i class="fas fa-clock"></i> What's your response time?</h4>
                    <p>We typically respond within 2–4 hours during business days. For urgent inquiries, call our support line directly for immediate assistance.</p>
                </div>
                <div class="faq-item reveal" style="transition-delay: 0.1s;">
                    <h4><i class="fas fa-chalkboard-user"></i> Can I schedule a demo?</h4>
                    <p>Absolutely. Fill out the contact form and mention "demo request" — we'll arrange a personalized walkthrough with our AI inspection specialists.</p>
                </div>
                <div class="faq-item reveal" style="transition-delay: 0.2s;">
                    <h4><i class="fas fa-shield-halved"></i> Is my data secure?</h4>
                    <p>Yes. We follow enterprise-grade AES-256 encryption and strict privacy protocols. All inspection data is protected and never shared without explicit consent.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="container">
        <div class="cta-section contact-cta">
            <div class="cta-content reveal">
                <h2>Ready to transform your inspections?</h2>
                <p>Join thousands of electrical professionals using AI to work smarter and safer.</p>
                <div class="cta-actions">
                    <a asp-action="AI_Scanner" asp-controller="Home" class="btn-primary btn-light">
                        <i class="fas fa-bolt"></i>
                        Start AI Scan
                    </a>
                    <a asp-action="Contact" asp-controller="Home" class="btn-outline-light">
                        Contact Sales <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
