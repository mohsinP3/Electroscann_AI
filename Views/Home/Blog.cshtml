@{
    ViewData["Title"] = "Blog & News | ElectroScan AI";
}

<style>
    /* ==========================================================================
       BLOG PAGE - PREMIUM SAAS STYLES
       ========================================================================== */
    .es-blog-page {
        --es-pine: #0B2B26;
        --es-forest: #0F3B33;
        --es-emerald: #1F8A6B;
        --es-mint: #6BCB9E;
        --es-bright-mint: #00D68F;
        --es-orange: #FF7A00;
        --es-light-bg: #F8FAF9;
        --es-card-bg: #FFFFFF;
        --es-border: #E2EFE9;
        --es-text-main: #0F221E;
        --es-text-muted: #4A635B;
        --es-font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
        --es-font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-family: var(--es-font-body);
        color: var(--es-text-main);
    }

    /* Hero Section */
    .blog-hero {
        position: relative;
        padding: 80px 0 50px;
        background: radial-gradient(120% 80% at 50% -10%, rgba(31, 138, 107, 0.12) 0%, rgba(255, 255, 255, 0) 70%), #FFFFFF;
        text-align: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #0B2B26;
        color: var(--es-mint);
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 20px;
        box-shadow: 0 4px 12px rgba(11, 43, 38, 0.15);
    }

    .blog-hero h1 {
        font-family: var(--es-font-heading);
        font-size: clamp(2.4rem, 4vw, 3.5rem);
        font-weight: 800;
        color: var(--es-pine);
        margin-bottom: 16px;
    }

    .blog-hero p {
        font-size: 1.12rem;
        color: var(--es-text-muted);
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .es-blog-container {
        padding: 40px 0 80px;
        max-width: 1140px;
    }

    /* Search Bar */
    .blog-search {
        max-width: 600px;
        margin: 0 auto 32px;
    }

    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 16px;
        padding: 6px 8px 6px 20px;
        box-shadow: 0 8px 24px rgba(11, 43, 38, 0.04);
        transition: all 180ms ease;
    }

    .search-wrapper:focus-within {
        border-color: var(--es-emerald);
        box-shadow: 0 0 0 4px rgba(31, 138, 107, 0.12);
    }

    .search-wrapper input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        font-size: 1rem;
        color: var(--es-text-main);
        font-family: var(--es-font-body);
    }

    .search-wrapper button {
        background: linear-gradient(135deg, var(--es-emerald) 0%, #166A52 100%);
        color: #FFFFFF;
        border: none;
        padding: 12px 20px;
        border-radius: 12px;
        cursor: pointer;
        transition: all 180ms ease;
    }

    .search-wrapper button:hover {
        background: linear-gradient(135deg, #166A52 0%, #0F3B33 100%);
        transform: scale(1.02);
    }

    /* Category Filter Buttons */
    .blog-categories {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 48px;
    }

    .category-btn {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        color: var(--es-text-muted);
        padding: 9px 20px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 180ms ease;
    }

    .category-btn:hover {
        border-color: var(--es-emerald);
        color: var(--es-emerald);
        transform: translateY(-2px);
    }

    .category-btn.active {
        background: var(--es-pine);
        color: var(--es-mint);
        border-color: var(--es-pine);
        box-shadow: 0 4px 14px rgba(11, 43, 38, 0.2);
    }

    /* Blog Grid & Cards (dynamically populated by JS into #blogGrid) */
    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        margin-bottom: 70px;
    }

    .blog-card {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 6px 20px rgba(11, 43, 38, 0.03);
        transition: all 220ms ease;
    }

    .blog-card:hover {
        transform: translateY(-6px);
        border-color: var(--es-emerald);
        box-shadow: 0 16px 36px rgba(31, 138, 107, 0.12);
    }

    .blog-card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .blog-card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .blog-meta-badge {
        display: inline-block;
        background: rgba(31, 138, 107, 0.08);
        color: var(--es-emerald);
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.78rem;
        font-weight: 700;
        margin-bottom: 12px;
        align-self: flex-start;
    }

    .blog-card-title {
        font-family: var(--es-font-heading);
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--es-pine);
        margin-bottom: 10px;
        line-height: 1.3;
    }

    .blog-card-excerpt {
        font-size: 0.92rem;
        color: var(--es-text-muted);
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .blog-card-footer {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.82rem;
        color: var(--es-text-muted);
        border-top: 1px solid var(--es-border);
        padding-top: 16px;
    }

    /* Newsletter Section */
    .blog-newsletter {
        background: linear-gradient(135deg, var(--es-pine) 0%, var(--es-forest) 100%);
        border-radius: 28px;
        padding: 60px 40px;
        color: #FFFFFF;
        text-align: center;
        margin-bottom: 80px;
    }

    .newsletter-card i {
        font-size: 2.8rem;
        color: var(--es-mint);
        margin-bottom: 20px;
    }

    .newsletter-card h2 {
        font-family: var(--es-font-heading);
        font-size: 2.2rem;
        font-weight: 800;
        color: #FFFFFF;
        margin-bottom: 12px;
    }

    .newsletter-card p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.05rem;
        max-width: 540px;
        margin: 0 auto 32px;
    }

    .newsletter-form {
        display: flex;
        justify-content: center;
        gap: 12px;
        max-width: 520px;
        margin: 0 auto;
    }

    .newsletter-form input {
        flex: 1;
        padding: 14px 20px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        color: #FFFFFF;
        font-size: 0.95rem;
        outline: none;
        backdrop-filter: blur(8px);
    }

    .newsletter-form input::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .newsletter-form input:focus {
        border-color: var(--es-mint);
        background: rgba(255, 255, 255, 0.18);
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--es-emerald) 0%, #166A52 100%);
        color: #FFFFFF !important;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(31, 138, 107, 0.3);
        transition: all 200ms ease;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #166A52 0%, #0F3B33 100%);
        transform: translateY(-2px);
    }

    @@media (max-width: 991px) {
        .blog-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .blog-grid {
            grid-template-columns: 1fr;
        }
        .newsletter-form {
            flex-direction: column;
        }
    }
</style>

<div class="es-blog-page">
    <!-- Blog Hero -->
    <div class="blog-hero">
        <div class="container">
            <div class="blog-hero-content reveal">
                <div class="hero-badge">
                    <i class="fas fa-newspaper"></i>
                    LATEST INSIGHTS
                </div>
                <h1>Electrical Safety Blog</h1>
                <p>Expert insights, industry news, and AI innovation for electrical professionals</p>
            </div>
        </div>
    </div>

    <div class="container es-blog-container">
        <!-- Search -->
        <div class="blog-search reveal">
            <div class="search-wrapper">
                <input type="text" id="searchInput" placeholder="Search articles by title or keyword..." />
                <button id="searchBtn"><i class="fas fa-search"></i></button>
            </div>
        </div>

        <!-- Categories -->
        <div class="blog-categories reveal">
            <button class="category-btn active" data-cat="all">All</button>
            <button class="category-btn" data-cat="AI Technology">AI Technology</button>
            <button class="category-btn" data-cat="Safety Tips">Safety Tips</button>
            <button class="category-btn" data-cat="Industry News">Industry News</button>
            <button class="category-btn" data-cat="Case Studies">Case Studies</button>
        </div>

        <!-- Blog Grid -->
        <div class="blog-grid reveal" id="blogGrid"></div>

        <!-- Newsletter -->
        <div class="blog-newsletter">
            <div class="newsletter-card reveal">
                <i class="fas fa-envelope-open-text"></i>
                <h2>Subscribe to Our Newsletter</h2>
                <p>Get the latest articles, industry insights, and AI updates delivered directly to your inbox.</p>
                <div class="newsletter-form">
                    <input type="email" id="newsletterEmail" placeholder="Enter your email address" />
                    <button class="btn-primary" id="newsletterBtn">Subscribe</button>
                </div>
            </div>
        </div>
    </div>
</div>
