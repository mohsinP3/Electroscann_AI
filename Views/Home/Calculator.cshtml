@model Electroscann_ai.Models.ViewModels.WireCalculatorViewModel
@{
    ViewData["Title"] = "Wire & Load Calculator";
}

<style>
    /* ==========================================================================
       WIRE & LOAD CALCULATOR - PREMIUM SAAS STYLES
       ========================================================================== */
    .es-calc-page {
        --es-pine: #0B2B26;
        --es-forest: #0F3B33;
        --es-emerald: #1F8A6B;
        --es-mint: #6BCB9E;
        --es-bright-mint: #00D68F;
        --es-orange: #FF7A00;
        --es-light-bg: #F8FAF9;
        --es-card-bg: #FFFFFF;
        --es-border: #E2EFE9;
        --es-text-main: #0F221E;
        --es-text-muted: #4A635B;
        --es-font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
        --es-font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .es-calc-hero {
        position: relative;
        padding: 80px 0 60px;
        background: radial-gradient(120% 80% at 50% -10%, rgba(31, 138, 107, 0.12) 0%, rgba(255, 255, 255, 0) 70%), #FFFFFF;
        text-align: center;
    }

    .es-calc-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #0B2B26;
        color: var(--es-mint);
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 20px;
        box-shadow: 0 4px 12px rgba(11, 43, 38, 0.15);
    }

    .es-calc-hero h1 {
        font-family: var(--es-font-heading);
        font-size: clamp(2.4rem, 4vw, 3.5rem);
        font-weight: 800;
        color: var(--es-pine);
        margin-bottom: 16px;
    }

    .es-calc-hero p {
        font-size: 1.12rem;
        color: var(--es-text-muted);
        max-width: 660px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .es-calc-container {
        padding: 30px 0 80px;
        max-width: 1140px;
    }

    /* Form Layout Grid */
    .es-calc-layout {
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: 32px;
        align-items: start;
    }

    .es-calc-card {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 24px;
        box-shadow: 0 8px 24px rgba(11, 43, 38, 0.04);
        overflow: hidden;
    }

    .es-calc-card-header {
        background: var(--es-light-bg);
        border-bottom: 1px solid var(--es-border);
        padding: 22px 28px;
    }

    .es-calc-card-header h4 {
        margin: 0;
        font-family: var(--es-font-heading);
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--es-pine);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .es-calc-card-header h4 i {
        color: var(--es-emerald);
    }

    .es-calc-card-body {
        padding: 32px;
    }

    /* Form Elements */
    .es-input-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 28px;
    }

    .es-input-group label {
        display: block;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--es-pine);
        margin-bottom: 8px;
    }

    .es-input-group input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--es-border);
        border-radius: 12px;
        font-size: 0.95rem;
        color: var(--es-text-main);
        outline: none;
        transition: all 200ms ease;
    }

    .es-input-group input:focus {
        border-color: var(--es-emerald);
        box-shadow: 0 0 0 4px rgba(31, 138, 107, 0.12);
    }

    .fixtures-title {
        font-family: var(--es-font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--es-pine);
        margin: 28px 0 18px;
        padding-top: 20px;
        border-top: 1px solid var(--es-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fixtures-title i {
        color: var(--es-emerald);
    }

    /* Counter Grid */
    .counter-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    .counter-group {
        background: var(--es-light-bg);
        border: 1px solid var(--es-border);
        border-radius: 16px;
        padding: 18px 14px;
        text-align: center;
        transition: all 200ms ease;
    }

    .counter-group:hover {
        border-color: var(--es-emerald);
        background: #FFFFFF;
        box-shadow: 0 6px 16px rgba(11, 43, 38, 0.05);
    }

    .counter-group i {
        font-size: 1.3rem;
        color: var(--es-emerald);
        margin-bottom: 8px;
    }

    .counter-value {
        font-family: var(--es-font-heading);
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--es-pine);
        margin: 4px 0 8px;
    }

    .counter-controls {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .counter-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid var(--es-border);
        background: #FFFFFF;
        color: var(--es-pine);
        font-weight: 800;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 150ms ease;
    }

    .counter-btn:hover {
        background: var(--es-emerald);
        color: #FFFFFF;
        border-color: var(--es-emerald);
    }

    .counter-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--es-text-muted);
    }

    /* Results Side Panel */
    .es-calc-results {
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 8px 24px rgba(11, 43, 38, 0.04);
        position: sticky;
        top: 30px;
    }

    .es-calc-results h4 {
        font-family: var(--es-font-heading);
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--es-pine);
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--es-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .es-calc-results h4 i {
        color: var(--es-emerald);
    }

    .result-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px dashed var(--es-border);
    }

    .result-item:last-of-type {
        border-bottom: none;
    }

    .result-label {
        font-size: 0.9rem;
        color: var(--es-text-muted);
        font-weight: 600;
    }

    .result-value {
        font-family: var(--es-font-heading);
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--es-pine);
    }

    .safety-warning {
        margin-top: 24px;
        background: rgba(31, 138, 107, 0.08);
        border: 1px solid rgba(31, 138, 107, 0.2);
        border-radius: 16px;
        padding: 16px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        color: var(--es-pine);
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .safety-warning i {
        color: var(--es-emerald);
        font-size: 1.2rem;
        margin-top: 2px;
    }

    .es-btn-orange {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: linear-gradient(135deg, var(--es-orange) 0%, #E66E00 100%);
        color: #FFFFFF !important;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none !important;
        border: none;
        width: 100%;
        box-shadow: 0 6px 18px rgba(255, 122, 0, 0.3);
        transition: all 200ms ease;
        cursor: pointer;
    }

    .es-btn-orange:hover {
        background: linear-gradient(135deg, #E66E00 0%, #CC6200 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(255, 122, 0, 0.4);
    }

    .guest-note {
        text-align: center;
        font-size: 0.85rem;
        color: var(--es-text-muted);
        margin-top: 14px;
        margin-bottom: 0;
    }

    .guest-note a {
        color: var(--es-emerald);
        font-weight: 700;
        text-decoration: none;
    }

    /* History Panel */
    .history-panel {
        margin-top: 50px;
        background: #FFFFFF;
        border: 1px solid var(--es-border);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(11, 43, 38, 0.04);
    }

    .history-header {
        background: var(--es-light-bg);
        border-bottom: 1px solid var(--es-border);
        padding: 20px 28px;
    }

    .history-header h4 {
        margin: 0;
        font-family: var(--es-font-heading);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--es-pine);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .history-body {
        padding: 24px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
    }

    .history-table th, .history-table td {
        padding: 14px 18px;
        text-align: left;
        border-bottom: 1px solid var(--es-border);
        font-size: 0.92rem;
    }

    .history-table th {
        background: var(--es-light-bg);
        font-weight: 700;
        color: var(--es-pine);
    }

    .history-summary {
        color: var(--es-text-muted);
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (max-width: 991px) {
        .es-calc-layout {
            grid-template-columns: 1fr;
        }
        .counter-grid, .es-input-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 576px) {
        .counter-grid, .es-input-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="es-calc-page">
    <!-- Hero -->
    <div class="es-calc-hero">
        <div class="container">
            <div class="es-calc-badge">
                <i class="fas fa-calculator"></i>
                SMART CALCULATIONS
            </div>
            <h1>Wire &amp; Load Calculator</h1>
            <p>
                NEC-compliant calculations for wire sizing, load capacity, breaker recommendations, 
                and safety guidelines.
            </p>
        </div>
    </div>

    <div class="container es-calc-container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">@TempData["Success"]</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4">
                @TempData["Info"]
                <a asp-action="Login" asp-controller="Account" class="alert-link">Sign in</a>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- PREFERENCES CONTROL BAR (LOCAL STORAGE PERSISTED) -->
        <div class="es-calc-card mb-4" id="preferencesCard" style="background: linear-gradient(135deg, #0B2B26 0%, #163E38 100%); color: #ffffff; border-radius: 12px; border: 1px solid rgba(107, 203, 158, 0.3);">
            <div class="es-calc-card-header d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 border-bottom border-secondary border-opacity-25">
                <h4 class="m-0 text-white" style="font-size: 1.1rem; font-weight: 700;">
                    <i class="fas fa-sliders-h me-2" style="color: #6BCB9E;"></i> Currency &amp; Power Unit Preferences
                </h4>
                <span class="badge rounded-pill text-uppercase px-3 py-2" style="background: rgba(107, 203, 158, 0.2); color: #6BCB9E; font-size: 0.75rem; letter-spacing: 0.5px;">
                    <i class="fas fa-save me-1"></i> Saved to LocalStorage
                </span>
            </div>
            <div class="es-calc-card-body p-3">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <label for="prefCurrencySelect" class="form-label text-white-50 fw-semibold small mb-1">Preferred Currency</label>
                        <select id="prefCurrencySelect" class="form-select bg-dark text-white border-secondary rounded-3">
                            <option value="PKR">₨ PKR (Pakistani Rupee)</option>
                            <option value="USD">$ USD (US Dollar)</option>
                            <option value="EUR">€ EUR (Euro)</option>
                            <option value="GBP">£ GBP (British Pound)</option>
                            <option value="AED">AED (UAE Dirham)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="prefPowerUnitSelect" class="form-label text-white-50 fw-semibold small mb-1">Preferred Power Unit</label>
                        <select id="prefPowerUnitSelect" class="form-select bg-dark text-white border-secondary rounded-3">
                            <option value="W">W (Watts)</option>
                            <option value="kW">kW (Kilowatts)</option>
                            <option value="HP">HP (Horsepower)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="prefTariffRateInput" class="form-label text-white-50 fw-semibold small mb-1">Electricity Rate / kWh (<span id="prefRateCurrencyCode">PKR</span>)</label>
                        <input type="number" id="prefTariffRateInput" class="form-control bg-dark text-white border-secondary rounded-3" value="35" min="1" step="0.5" />
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Calculator" asp-controller="Home" method="post" id="calculatorForm"
              data-has-result="@(Model.HasResult ? "true" : "false")">
            @Html.AntiForgeryToken()

            <div class="es-calc-layout">
                <!-- Input Panel -->
                <div class="es-calc-card">
                    <div class="es-calc-card-header">
                        <h4><i class="fas fa-ruler-combined"></i> Room Specifications</h4>
                    </div>
                    <div class="es-calc-card-body">
                        <div class="es-input-row">
                            <div class="es-input-group">
                                <label asp-for="RoomLength"></label>
                                <input asp-for="RoomLength" type="number" id="roomLength" step="any" min="1" max="500" class="form-control" />
                                <span asp-validation-for="RoomLength" class="text-danger small"></span>
                            </div>
                            <div class="es-input-group">
                                <label asp-for="RoomWidth"></label>
                                <input asp-for="RoomWidth" type="number" id="roomWidth" step="any" min="1" max="500" class="form-control" />
                                <span asp-validation-for="RoomWidth" class="text-danger small"></span>
                            </div>
                            <div class="es-input-group">
                                <label asp-for="RoomHeight"></label>
                                <input asp-for="RoomHeight" type="number" id="roomHeight" step="any" min="7" max="30" class="form-control" />
                                <span asp-validation-for="RoomHeight" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fixtures-title">
                            <i class="fas fa-plug"></i>
                            Electrical Fixtures &amp; Loads
                        </h5>

                        <input type="hidden" asp-for="Lights" id="lightsInput" />
                        <input type="hidden" asp-for="Fans" id="fansInput" />
                        <input type="hidden" asp-for="Sockets" id="socketsInput" />
                        <input type="hidden" asp-for="AcUnits" id="acInput" />
                        <input type="hidden" asp-for="HeavyLoads" id="heavyInput" />

                        <div class="counter-grid">
                            <div class="counter-group">
                                <i class="fas fa-lightbulb"></i>
                                <div class="counter-value" id="lightVal">@Model.Lights</div>
                                <div class="counter-controls">
                                    <button type="button" class="counter-btn" onclick="modifyCounter('lights', -1)">−</button>
                                    <button type="button" class="counter-btn" onclick="modifyCounter('lights', 1)">+</button>
                                </div>
                                <span class="counter-label">Lights (60W)</span>
                                <span asp-validation-for="Lights" class="text-danger small"></span>
                            </div>
                            <div class="counter-group">
                                <i class="fas fa-fan"></i>
                                <div class="counter-value" id="fanVal">@Model.Fans</div>
                                <div class="counter-controls">
                                    <button type="button" class="counter-btn" onclick="modifyCounter('fans', -1)">−</button>
                                    <button type="button" class="counter-btn" onclick="modifyCounter('fans', 1)">+</button>
                                </div>
                                <span class="counter-label">Fans (80W)</span>
                                <span asp-validation-for="Fans" class="text-danger small"></span>
                            </div>
                            <div class="counter-group">
                                <i class="fas fa-plug"></i>
                                <div class="counter-value" id="socketVal">@Model.Sockets</div>
                                <div class="counter-controls">
                                    <button type="button" class="counter-btn" onclick="modifyCounter('sockets', -1)">−</button>
                                    <button type="button" class="counter-btn" onclick="modifyCounter('sockets', 1)">+</button>
                                </div>
                                <span class="counter-label">Sockets (150W)</span>
                                <span asp-validation-for="Sockets" class="text-danger small"></span>
                            </div>
                            <div class="counter-group">
                                <i class="fas fa-wind"></i>
                                <div class="counter-value" id="acVal">@Model.AcUnits</div>
                                <div class="counter-controls">
                                    <button type="button" class="counter-btn" onclick="modifyCounter('ac', -1)">−</button>
                                    <button type="button" class="counter-btn" onclick="modifyCounter('ac', 1)">+</button>
                                </div>
                                <span class="counter-label">AC Units (2000W)</span>
                                <span asp-validation-for="AcUnits" class="text-danger small"></span>
                            </div>
                            <div class="counter-group">
                                <i class="fas fa-industry"></i>
                                <div class="counter-value" id="heavyVal">@Model.HeavyLoads</div>
                                <div class="counter-controls">
                                    <button type="button" class="counter-btn" onclick="modifyCounter('heavy', -1)">−</button>
                                    <button type="button" class="counter-btn" onclick="modifyCounter('heavy', 1)">+</button>
                                </div>
                                <span class="counter-label">Heavy Loads (3000W)</span>
                                <span asp-validation-for="HeavyLoads" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="calculator-actions">
                            <button type="submit" class="es-btn-orange" id="calculateBtn">
                                <i class="fas fa-calculator"></i>
                                Calculate Now
                            </button>
                            @if (!(User.Identity?.IsAuthenticated ?? false))
                            {
                                <p class="guest-note">
                                    Guests can calculate freely.
                                    <a asp-action="Login" asp-controller="Account">Sign in</a> to save results.
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Results Panel -->
                <div class="es-calc-results">
                    <h4><i class="fas fa-chart-line"></i> Calculation Results</h4>
                    <div class="result-item">
                        <span class="result-label">Total Wire Length</span>
                        <span class="result-value" id="wireLengthDisplay">@(Model.HasResult ? $"{Model.Distance:0} m" : "--")</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Recommended Wire Gauge</span>
                        <span class="result-value" id="wireGaugeDisplay">@(Model.HasResult ? Model.WireSize : "--")</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Total Electrical Load</span>
                        <span class="result-value" id="loadDisplay">@(Model.HasResult ? $"{Model.Load:N0} W" : "--")</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Load (Preferred Unit)</span>
                        <span class="result-value fw-bold text-success" id="loadConvertedDisplay" style="color: #6BCB9E !important;">--</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Est. Monthly Operating Cost</span>
                        <span class="result-value fw-bold text-success" id="costMonthlyDisplay" style="color: #6BCB9E !important;">--</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Est. Daily Operating Cost</span>
                        <span class="result-value" id="costDailyDisplay">--</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Current (Amps)</span>
                        <span class="result-value" id="currentDisplay">@(Model.HasResult ? $"{Model.CurrentAmps:0.#} A" : "--")</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">MCB / Breaker Rating</span>
                        <span class="result-value" id="breakerDisplay">@(Model.HasResult ? Model.BreakerRating : "--")</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Room Area</span>
                        <span class="result-value" id="areaDisplay">@(Model.HasResult ? $"{Model.RoomArea:0.#} sq ft" : "--")</span>
                    </div>

                    <div class="safety-warning" id="safetyBox">
                        <i class="fas fa-shield-alt"></i>
                        <div id="safetyMessage">
                            @(Model.HasResult ? Model.SafetyMessage : "Configure room specifications & fixture counts above, then click Calculate Now.")
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <!-- History Panel -->
        <div class="history-panel mt-4 @((Model.RecentCalculations != null && Model.RecentCalculations.Count > 0) ? "" : "d-none")" id="historyPanel">
            <div class="history-header d-flex align-items-center justify-content-between">
                <h4><i class="fas fa-history text-emerald"></i> Calculation History</h4>
                <span class="badge bg-light text-muted small">Saved Session Records</span>
            </div>
            <div class="history-body">
                <div class="table-responsive">
                    <table class="history-table table align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Load</th>
                                <th>Distance</th>
                                <th>Wire Size</th>
                                <th>Summary</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody">
                            @if (Model.RecentCalculations != null)
                            {
                                @foreach (var item in Model.RecentCalculations)
                                {
                                    <tr id="calcRow-@item.Id">
                                        <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                                        <td><strong>@item.Load.ToString("N0") W</strong></td>
                                        <td>@item.Distance.ToString("0") m</td>
                                        <td><span class="badge bg-emerald-subtle text-emerald">@item.WireSize</span></td>
                                        <td class="history-summary">@item.Result</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-success btn-sm" onclick="viewCalcDetails(@item.Id, '@item.Load.ToString("N0") W', '@item.Distance.ToString("0") m', '@item.WireSize', '@item.Result', '@item.CreatedAt.ToLocalTime().ToString("g")')">
                                                    <i class="fas fa-eye me-1"></i> View
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteCalc(@item.Id)">
                                                    <i class="fas fa-trash-alt me-1"></i> Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Calculation Details Modal -->
<div class="modal fade" id="calcDetailsModal" tabindex="-1" aria-labelledby="calcDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-header-title m-0 text-white" id="calcDetailsModalLabel">
                    <i class="fas fa-calculator text-emerald me-2"></i> Calculation Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <span class="text-muted small fw-semibold">RECORD DATE</span>
                    <h6 class="fw-bold text-dark mt-1" id="modalCalcDate">--</h6>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small d-block mb-1">Total Electrical Load</span>
                            <strong class="fs-5 text-emerald" id="modalCalcLoad">-- W</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small d-block mb-1">Estimated Distance</span>
                            <strong class="fs-5 text-dark" id="modalCalcDistance">-- m</strong>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <span class="text-muted small fw-semibold">RECOMMENDED WIRE GAUGE</span>
                    <div class="mt-1">
                        <span class="badge bg-emerald-subtle text-emerald fs-6 px-3 py-2 fw-bold" id="modalCalcWireSize">--</span>
                    </div>
                </div>
                <div class="mb-3">
                    <span class="text-muted small fw-semibold">CALCULATION BREAKDOWN &amp; SAFETY NOTES</span>
                    <p class="p-3 bg-light rounded-3 border text-secondary mt-1 small" id="modalCalcResult">--</p>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let debounceTimer = null;

            function triggerLiveCalculation() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(async function () {
                    const roomLength = parseFloat(document.getElementById("roomLength")?.value) || 0;
                    const roomWidth = parseFloat(document.getElementById("roomWidth")?.value) || 0;
                    const roomHeight = parseFloat(document.getElementById("roomHeight")?.value) || 0;

                    const lights = parseInt(document.getElementById("lightsInput")?.value) || 0;
                    const fans = parseInt(document.getElementById("fansInput")?.value) || 0;
                    const sockets = parseInt(document.getElementById("socketsInput")?.value) || 0;
                    const acUnits = parseInt(document.getElementById("acInput")?.value) || 0;
                    const heavyLoads = parseInt(document.getElementById("heavyInput")?.value) || 0;

                    if (roomLength <= 0 || roomWidth <= 0) return;

                    const payload = {
                        roomLength: roomLength,
                        roomWidth: roomWidth,
                        roomHeight: roomHeight,
                        lights: lights,
                        fans: fans,
                        sockets: sockets,
                        acUnits: acUnits,
                        heavyLoads: heavyLoads
                    };

                    try {
                        const response = await fetch("/api/calculator/calculate", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify(payload)
                        });

                        if (response.ok) {
                            const data = await response.json();
                            if (data && data.success) {
                                const wLen = document.getElementById("wireLengthDisplay");
                                const wGauge = document.getElementById("wireGaugeDisplay");
                                const loadD = document.getElementById("loadDisplay");
                                const curD = document.getElementById("currentDisplay");
                                const brkD = document.getElementById("breakerDisplay");
                                const areaD = document.getElementById("areaDisplay");
                                const safeM = document.getElementById("safetyMessage");

                                if (wLen) wLen.innerText = data.wireLength || "--";
                                if (wGauge) wGauge.innerText = data.wireGauge || "--";
                                if (loadD) loadD.innerText = data.load || "--";
                                if (curD) curD.innerText = data.currentAmps || "--";
                                if (brkD) brkD.innerText = data.breakerRating || "--";
                                if (areaD) areaD.innerText = data.roomArea || "--";
                                if (safeM && data.safetyMessage) safeM.innerText = data.safetyMessage;
                            }
                        }
                    } catch (e) {
                        console.warn("Live calculation preview error:", e);
                    }
                }, 400);
            }

            window.modifyCounter = function (type, delta) {
                let inputId = type + "Input";
                let valId = type + "Val";
                if (type === 'ac') { inputId = "acInput"; valId = "acVal"; }
                if (type === 'heavy') { inputId = "heavyInput"; valId = "heavyVal"; }
                if (type === 'lights') { inputId = "lightsInput"; valId = "lightVal"; }
                if (type === 'fans') { inputId = "fansInput"; valId = "fanVal"; }
                if (type === 'sockets') { inputId = "socketsInput"; valId = "socketVal"; }

                const inputEl = document.getElementById(inputId);
                const valEl = document.getElementById(valId);
                if (!inputEl || !valEl) return;

                let currentVal = parseInt(inputEl.value) || 0;
                let newVal = Math.max(0, currentVal + delta);
                inputEl.value = newVal;
                valEl.innerText = newVal;

                triggerLiveCalculation();
            };

            const inputs = ["roomLength", "roomWidth", "roomHeight"];
            inputs.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener("input", triggerLiveCalculation);
                }
            });

            window.viewCalcDetails = async function(id, load, distance, wireSize, result, dateFormatted) {
                try {
                    const resp = await fetch(`/api/calculator/details/${id}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        if (data && data.success) {
                            document.getElementById("modalCalcDate").innerText = data.dateFormatted || dateFormatted || "--";
                            document.getElementById("modalCalcLoad").innerText = data.load || load || "-- W";
                            document.getElementById("modalCalcDistance").innerText = data.distance || distance || "-- m";
                            document.getElementById("modalCalcWireSize").innerText = data.wireSize || wireSize || "--";
                            document.getElementById("modalCalcResult").innerText = data.result || result || "--";
                        } else {
                            document.getElementById("modalCalcDate").innerText = dateFormatted || "--";
                            document.getElementById("modalCalcLoad").innerText = load || "-- W";
                            document.getElementById("modalCalcDistance").innerText = distance || "-- m";
                            document.getElementById("modalCalcWireSize").innerText = wireSize || "--";
                            document.getElementById("modalCalcResult").innerText = result || "--";
                        }
                    }
                } catch (e) {
                    document.getElementById("modalCalcDate").innerText = dateFormatted || "--";
                    document.getElementById("modalCalcLoad").innerText = load || "-- W";
                    document.getElementById("modalCalcDistance").innerText = distance || "-- m";
                    document.getElementById("modalCalcWireSize").innerText = wireSize || "--";
                    document.getElementById("modalCalcResult").innerText = result || "--";
                }

                const modalEl = document.getElementById("calcDetailsModal");
                if (modalEl && window.bootstrap) {
                    const modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();
                }
            };

            window.deleteCalc = async function(id) {
                if (!confirm("Are you sure you want to delete this saved calculation?")) {
                    return;
                }

                try {
                    const response = await fetch(`/api/calculator/delete/${id}`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data && data.success) {
                            const row = document.getElementById(`calcRow-${id}`);
                            if (row) {
                                row.style.transition = "all 0.3s ease";
                                row.style.opacity = "0";
                                setTimeout(() => {
                                    row.remove();
                                    const tbody = document.getElementById("historyTableBody");
                                    if (tbody && tbody.children.length === 0) {
                                        const panel = document.getElementById("historyPanel");
                                        if (panel) panel.classList.add("d-none");
                                    }
                                }, 300);
                            } else {
                                location.reload();
                            }
                        } else {
                            alert(data.message || "Could not delete calculation record.");
                        }
                    }
                } catch (e) {
                    console.error("Delete calculation error:", e);
                    alert("An error occurred while deleting the calculation record.");
                }
            };
        });
    </script>
}
