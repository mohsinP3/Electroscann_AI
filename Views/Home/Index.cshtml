@{
    ViewData["Title"] = "AI-Powered Electrical Inspection Platform";
}

<!-- ==========================================================================
     SECTION 1: HERO SECTION (DARK MODERN SAAS)
     ========================================================================== -->
<section class="es-dark-hero">
    <div class="container">
        <div class="es-hero-grid">
            <!-- Left Hero Content -->
            <div class="es-hero-content-col">
                <div class="es-pill-badge">
                    <span class="es-pulse-dot"></span>
                    <span>Next-Gen AI Inspection Engine 2.0</span>
                </div>

                <h1 class="es-hero-title-main">
                    Smarter Scans.<br>
                    <span class="es-gradient-heading">Safer Electrical Systems.</span>
                </h1>

                <p class="es-hero-subtext">
                    ElectroScan AI leverages deep neural networks and computer vision to detect thermal anomalies, calculate branch loads, and generate NEC-compliant reports — 70% faster with 99.8% precision.
                </p>

                <div class="es-hero-btn-group">
                    <a asp-action="AI_Scanner" asp-controller="Home" class="es-btn-hero-primary">
                        <i class="fas fa-sparkles"></i>
                        <span>Start Free AI Scan</span>
                    </a>
                    <a asp-action="Service" asp-controller="Home" class="es-btn-hero-glass">
                        <i class="fas fa-play-circle"></i>
                        <span>Watch Platform Demo</span>
                    </a>
                </div>

                <!-- Proof Strip -->
                <div class="es-hero-proof-bar">
                    <div class="es-proof-avatars">
                        <img src="~/Image/testimonial-1.jpg" alt="Inspector" class="es-proof-avatar" onerror="this.src='/Image/user.jpg';" />
                        <img src="~/Image/testimonial-2.jpg" alt="Engineer" class="es-proof-avatar" onerror="this.src='/Image/user.jpg';" />
                        <img src="~/Image/user.jpg" alt="Master Electrician" class="es-proof-avatar" onerror="this.src='/Image/user.jpg';" />
                    </div>
                    <div class="es-proof-text">
                        <strong>Trusted by 500+ Enterprise Firms</strong><br>
                        <span>Over 120,000+ electrical panels inspected nationwide</span>
                    </div>
                </div>
            </div>

            <!-- Right Hero Visual Frame with HUD Overlays -->
            <div class="es-hero-visual-container">
                <div class="es-product-mock-frame">
                    <div class="es-mock-header">
                        <div class="es-mock-dots">
                            <span class="es-mock-dot red"></span>
                            <span class="es-mock-dot yellow"></span>
                            <span class="es-mock-dot green"></span>
                        </div>
                        <span class="es-mock-title">ElectroScan AI v2.0 — Thermal Telemetry HUD</span>
                    </div>

                    <div class="es-mock-img-wrap">
                        <img src="~/Image/homeheader.jpg" alt="AI Electrical Inspection Telemetry" onerror="this.src='/Image/about.jpg';" />
                    </div>
                </div>

                <!-- Floating HUD Card 1 -->
                <div class="es-hud-card hud-top-right">
                    <div class="es-hud-icon">
                        <i class="fas fa-microchip"></i>
                    </div>
                    <div class="es-hud-info">
                        <strong>AI Thermal Scan Active</strong>
                        <span>99.8% Anomaly Precision Score</span>
                    </div>
                </div>

                <!-- Floating HUD Card 2 -->
                <div class="es-hud-card hud-bottom-left">
                    <div class="es-hud-icon" style="background: rgba(0, 214, 143, 0.25); color: #00D68F;">
                        <i class="fas fa-shield-check"></i>
                    </div>
                    <div class="es-hud-info">
                        <strong>NEC 2026 Compliant</strong>
                        <span>0 Critical Faults Detected</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 2: ENTERPRISE METRICS & STATISTICS STRIP
     ========================================================================== -->
<section class="es-stats-strip-section">
    <div class="container">
