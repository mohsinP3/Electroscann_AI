        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 3: BENTO BOX CORE ADVANTAGES
     ========================================================================== -->
<section class="es-section-padding es-bg-light-surface">
    <div class="container">
        <div class="es-section-header-center">
            <span class="es-pill-badge">
                <i class="fas fa-bolt"></i> Platform Capabilities
            </span>
            <h2 class="es-section-title-lg">Engineered for absolute accuracy in the field</h2>
            <p class="es-section-subtext">
                From thermal imagery analysis to automated NEC compliance, every feature is built to cut inspection overhead and eliminate guesswork.
            </p>
        </div>

        <div class="es-bento-grid">
            <!-- Bento Item 1: Large Featured Card -->
            <div class="es-bento-card es-bento-col-8">
                <div class="es-bento-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <h3>AI Computer Vision & Thermal Scanning</h3>
                <p>
                    Deep convolutional neural networks analyze infrared thermography and high-res optical photos to detect hotspots, loose lugs, phase imbalance, and degradation before catastrophic failures occur.
                </p>
                <div class="es-bento-preview-widget">
                    <div class="es-widget-header">
                        <span><i class="fas fa-microscope text-mint"></i> AI Diagnostic Stream #4092</span>
                        <span class="es-widget-badge-ok"><i class="fas fa-check-circle"></i> Live Sync</span>
                    </div>
                    <div class="es-widget-row">
                        <span>Thermal Delta: +14.2°C</span>
                        <span class="text-warning">Status: Warning Level 2</span>
                    </div>
                    <div class="es-widget-row">
                        <span>Busbar Imbalance: 1.4%</span>
                        <span class="es-widget-badge-ok">Status: Optimal</span>
                    </div>
                </div>
                <div style="margin-top: 24px;">
                    <a asp-action="Service" asp-controller="Home" asp-fragment="ai-detection" class="es-bento-link">
                        <span>Explore AI Diagnostic Engine</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Bento Item 2: Medium Card -->
            <div class="es-bento-card es-bento-col-4">
                <div class="es-bento-icon" style="background: rgba(255, 122, 0, 0.1); color: var(--es-orange);">
                    <i class="fas fa-shield-check"></i>
                </div>
                <h3>Automated NEC & NFPA Compliance</h3>
                <p>
                    Instant compliance auditing mapped directly to NEC 2026, NFPA 70E safety standards, and OSHA guidelines.
                </p>
                <a asp-action="Service" asp-controller="Home" asp-fragment="safety-compliance" class="es-bento-link">
                    <span>View Compliance Engine</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <!-- Bento Item 3: Medium Card -->
            <div class="es-bento-card es-bento-col-4">
                <div class="es-bento-icon">
                    <i class="fas fa-calculator"></i>
                </div>
                <h3>Real-Time Feeder & Load Optimizer</h3>
                <p>
                    Calculate branch circuit loads, transformer capacities, and feeder demand factors instantly without manual math errors.
                </p>
                <a asp-action="Calculator" asp-controller="Home" class="es-bento-link">
                    <span>Open Load Calculator</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <!-- Bento Item 4: Large Card -->
            <div class="es-bento-card es-bento-col-8">
                <div class="es-bento-icon" style="background: rgba(0, 214, 143, 0.12); color: var(--es-bright-mint);">
                    <i class="fas fa-file-signature"></i>
                </div>
                <h3>One-Click Signed Inspection Reports</h3>
                <p>
                    Transform raw field imagery and measurements into executive-ready, digital PDF reports complete with thermal imagery overlays, risk score matrices, and recommended mitigation actions in under 10 seconds.
                </p>
                <a asp-action="AI_Scanner" asp-controller="Home" class="es-bento-link">
                    <span>Try Instant Report Generator</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 4: HOW IT WORKS (INTERACTIVE 4-STEP TIMELINE)
     ========================================================================== -->
<section class="es-section-padding">
    <div class="container">
        <div class="es-section-header-center">
            <span class="es-pill-badge">
                <i class="fas fa-route"></i> Workflow Pipeline
            </span>
            <h2 class="es-section-title-lg">From raw field scan to signed report in 4 steps</h2>
            <p class="es-section-subtext">
                Streamline your inspection workflow with an automated digital process built for modern electrical contractors.
            </p>
        </div>

        <div class="es-timeline-grid">
            <!-- Step 1 -->
            <div class="es-timeline-step-card">
                <div class="es-step-number-badge">01</div>
                <h4>Capture & Upload</h4>
                <p>Snap panel thermal or optical photos using your smartphone, FLIR camera, or drone sensor directly into the web platform.</p>
            </div>

            <!-- Step 2 -->
            <div class="es-timeline-step-card">
                <div class="es-step-number-badge">02</div>
                <h4>Neural Diagnostics</h4>
                <p>ElectroScan AI models scan component signatures, comparing thermography against 2,000,000+ panel signatures.</p>
            </div>

            <!-- Step 3 -->
            <div class="es-timeline-step-card">
                <div class="es-step-number-badge">03</div>
                <h4>Risk Severity Scoring</h4>
                <p>Receive immediate hazard classifications (Low Risk, Thermal Warning, Critical Arc Danger) with exact lug coordinates.</p>
            </div>

            <!-- Step 4 -->
            <div class="es-timeline-step-card">
                <div class="es-step-number-badge">04</div>
                <h4>One-Click PDF Export</h4>
                <p>Download or email signed, NEC-compliant inspection reports to clients, facility owners, or municipal inspectors.</p>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 5: SMART SOLUTIONS & PLATFORM CAPABILITIES
     ========================================================================== -->
<section class="es-section-padding es-bg-light-surface">
    <div class="container">
        <div class="es-section-header-center">
            <span class="es-pill-badge">
                <i class="fas fa-layer-group"></i> Smart Solutions
            </span>
            <h2 class="es-section-title-lg">Tailored for Electricians, Engineers & Facilities</h2>
        </div>

