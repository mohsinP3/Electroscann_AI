@section Scripts {
    <script>
        // FAQ Accordion Toggle Function
        function toggleFaq(element) {
            const faqItem = element.parentElement;
            const isOpen = faqItem.classList.contains('active');

            // Close all items
            document.querySelectorAll('.es-faq-item').forEach(item => {
                item.classList.remove('active');
            });

            // Toggle current item if was closed
            if (!isOpen) {
                faqItem.classList.add('active');
            }
        }

        // Contact Form Submission Handler
        document.getElementById('luxuryContactForm')?.addEventListener('submit', function (e) {
            e.preventDefault();
            const name = document.getElementById('name').value;
            if (name) {
                showToast('Thank you, ' + name + '! Your inquiry has been sent to our engineering team. 🚀');
                this.reset();
            }
        });

        // Newsletter Subscription Handler
        document.getElementById('subscribeNewsBtn')?.addEventListener('click', function () {
            const emailInput = document.getElementById('newsEmail');
            const email = emailInput ? emailInput.value : '';
            if (email && email.includes('@@')) {
                showToast('Subscribed to ElectroScan AI Insights newsletter! ⚡');
                if (emailInput) emailInput.value = '';
            } else {
                showToast('Please enter a valid work email address.');
            }
        });
    </script>
}
