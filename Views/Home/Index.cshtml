            </div>

            <div class="es-stat-card">
                <div class="es-stat-card-num">500<span>+</span></div>
                <div class="es-stat-card-label">Enterprise Contractors</div>
                <div class="es-stat-card-sub">Zero compliance audit failures</div>
            </div>

            <div class="es-stat-card">
                <div class="es-stat-card-num">$4.2<span>M+</span></div>
                <div class="es-stat-card-label">Prevented Outage Costs</div>
                <div class="es-stat-card-sub">Predictive arc risk avoidance</div>
