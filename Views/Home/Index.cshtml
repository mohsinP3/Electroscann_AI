            <span class="es-pill-filter">System Telemetry</span>
        </div>

        <div class="es-bento-grid">
            <div class="es-bento-card es-bento-col-4">
                <div class="es-bento-icon">
                    <i class="fas fa-microscope"></i>
                </div>
                <h3>AI Diagnostic Scanner</h3>
                <p>Detect thermal anomalies, arc risks, and component degradation in real-time with sub-millimeter precision.</p>
                <a asp-action="AI_Scanner" asp-controller="Home" class="es-btn-outline-emerald">Launch AI Scanner</a>
            </div>

            <div class="es-bento-card es-bento-col-4">
                <div class="es-bento-icon" style="background: rgba(255, 122, 0, 0.1); color: var(--es-orange);">
                    <i class="fas fa-calculator"></i>
                </div>
                <h3>Smart Load Calculator</h3>
                <p>Calculate service panel demand, feeder conductor sizing, and transformer loads adhering strictly to NEC Article 220.</p>
                <a asp-action="Calculator" asp-controller="Home" class="es-btn-outline-emerald">Open Calculator</a>
            </div>

            <div class="es-bento-card es-bento-col-4">
                <div class="es-bento-icon" style="background: rgba(0, 214, 143, 0.12); color: var(--es-bright-mint);">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3>Market Rates & Monitor</h3>
                <p>Track regional contractor labor rates, material price shifts, and facility system telemetry live.</p>
                <a asp-action="Market_Rates" asp-controller="Home" class="es-btn-outline-emerald">View Market Rates</a>
            </div>
        </div>
    </div>
</section>

