@model List<ElectroScanAI.Models.Entities.Electrician>
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Electricians Management";
    ViewBag.PageTitle = "Electricians";
    ViewBag.ActivePage = "Electricians";
}

<div class="page-header">
    <h1>Electricians Directory</h1>
    <p>Manage electrician profiles, licensing verification, and ratings.</p>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="table-card-title"><i class="fas fa-bolt"></i> Registered Electricians (@(Model?.Count ?? 0))</div>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>License No.</th>
                <th>Experience</th>
                <th>Rating</th>
                <th>Verified</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var ele in Model)
                {
                    <tr>
                        <td>#ELC-@ele.Id.ToString("D3")</td>
                        <td class="fw-bold">@ele.User?.FullName</td>
                        <td>@(string.IsNullOrEmpty(ele.LicenseNumber) ? "N/A" : ele.LicenseNumber)</td>
                        <td>@ele.YearsOfExperience yrs</td>
                        <td><i class="fas fa-star text-warning me-1"></i>@ele.Rating.ToString("F1") (@ele.TotalReviews)</td>
                        <td>
                            @if (ele.IsVerified)
                            {
                                <span class="badge badge-green"><i class="fas fa-shield-alt me-1"></i> Verified</span>
                            }
                            else
                            {
                                <span class="badge badge-yellow">Unverified</span>
                            }
                        </td>
                        <td>
                            <form asp-controller="Dashboard" asp-action="VerifyElectrician" asp-route-id="@ele.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-edit" title="Toggle Verification">
                                    <i class="fas @(ele.IsVerified ? "fa-user-slash" : "fa-user-check")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No electricians found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
