@model List<ElectroScanAI.Models.Entities.Subscription>
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Subscriptions Management";
    ViewBag.PageTitle = "Subscriptions";
    ViewBag.ActivePage = "Subscriptions";
}

<div class="page-header">
    <h1>Subscriptions</h1>
    <p>Monitor active platform membership plans and renewals.</p>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="table-card-title"><i class="fas fa-crown"></i> Active Subscriptions (@(Model?.Count ?? 0))</div>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>User</th>
                <th>Plan</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var sub in Model)
                {
                    <tr>
                        <td>#SUB-@sub.Id.ToString("D3")</td>
                        <td class="fw-bold">@sub.User?.FullName (@sub.User?.Email)</td>
                        <td><span class="badge bg-success fw-bold">@sub.Plan</span></td>
                        <td>@sub.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@sub.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (sub.IsActive)
                            {
                                <span class="badge badge-green">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-gray">Expired</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No subscriptions found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
