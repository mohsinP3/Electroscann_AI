@model List<ElectroScanAI.Models.Entities.ContactMessage>
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Inquiries & Messages";
    ViewBag.PageTitle = "Messages";
    ViewBag.ActivePage = "Messages";
}

<div class="page-header">
    <h1>Contact Inquiries</h1>
    <p>Manage visitor support inquiries and contact form submissions.</p>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="table-card-title"><i class="fas fa-envelope"></i> Contact Submissions (@(Model?.Count ?? 0))</div>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email / Phone</th>
                <th>Subject</th>
                <th>Message</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var msg in Model)
                {
                    <tr>
                        <td>#MSG-@msg.Id.ToString("D3")</td>
                        <td class="fw-bold">@msg.Name</td>
                        <td>
                            <div>@msg.Email</div>
                            <small class="text-muted">@msg.Phone</small>
                        </td>
                        <td class="fw-bold">@msg.Subject</td>
                        <td style="max-width: 300px;">@msg.Message</td>
                        <td>
                            @if (msg.IsResolved)
                            {
                                <span class="badge badge-green">Resolved</span>
                            }
                            else
                            {
                                <span class="badge badge-yellow">Unresolved</span>
                            }
                        </td>
                        <td>
                            <form asp-controller="Dashboard" asp-action="ResolveMessage" asp-route-id="@msg.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-edit" title="Toggle Resolved Status"><i class="fas fa-check"></i></button>
                            </form>
                            <form asp-controller="Dashboard" asp-action="DeleteMessage" asp-route-id="@msg.Id" method="post" class="d-inline" onsubmit="return confirm('Delete message?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-delete" title="Delete Message"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No contact messages received yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
