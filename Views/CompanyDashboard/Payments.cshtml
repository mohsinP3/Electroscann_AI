@model List<ElectroScanAI.Models.Entities.Payment>
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Payments & Billing";
    ViewBag.PageTitle = "Payments";
    ViewBag.ActivePage = "Payments";
    decimal totalSpent = ViewBag.TotalSpent ?? 0m;
}

<div class="page-header">
    <h1>Payments & Billing</h1>
    <p>Track your spending, subscription plans, invoices, and transaction history</p>
</div>

<!-- Stats -->
<div class="stats-grid mb-4">
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-receipt"></i></div>
        <div class="stat-value">PKR @totalSpent.ToString("N0")</div>
        <div class="stat-label">Total Spent</div>
        <div class="stat-change up"><i class="fas fa-check"></i> Account Current</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-file-invoice-dollar"></i></div>
        <div class="stat-value">@(Model?.Count ?? 0)</div>
        <div class="stat-label">Total Transactions</div>
        <div class="stat-change up"><i class="fas fa-history"></i> Logged</div>
    </div>
</div>

<!-- Transaction History Table -->
<div class="table-card">
    <div class="table-card-header">
        <div class="table-card-title"><i class="fas fa-history"></i> Transaction History (@(Model?.Count ?? 0))</div>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Transaction ID</th>
                <th>Payment Date</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="font-family:monospace;">#@p.TransactionId</td>
                        <td>@p.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="fw-bold text-success">PKR @p.Amount.ToString("N0")</td>
                        <td>@p.PaymentMethod</td>
                        <td>
                            @if (p.Status == ElectroScanAI.Models.Enums.PaymentStatus.Paid)
                            {
                                <span class="badge badge-green"><i class="fas fa-check-circle me-1"></i> @p.Status</span>
                            }
                            else if (p.Status == ElectroScanAI.Models.Enums.PaymentStatus.Pending)
                            {
                                <div>
                                    <span class="badge badge-warning"><i class="fas fa-clock me-1"></i> Pending</span>
                                    <form asp-controller="Subscription" asp-action="RetryPayment" method="post" class="d-inline ms-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Retry</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <span class="badge badge-red"><i class="fas fa-times-circle me-1"></i> @p.Status</span>
                                    <form asp-controller="Subscription" asp-action="RetryPayment" method="post" class="d-inline ms-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Retry</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        <i class="fas fa-receipt fa-3x mb-3 text-secondary d-block"></i>
                        No payment records found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
