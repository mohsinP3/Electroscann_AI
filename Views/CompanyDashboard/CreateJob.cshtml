@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Post New Job";
    ViewBag.PageTitle = "Post Job";
    ViewBag.ActivePage = "Jobs";
}

<div class="card shadow-sm border-0 p-4 rounded-3 max-w-2xl mx-auto">
    <h3 class="fw-bold mb-4"><i class="fas fa-plus-circle text-success me-2"></i>Post New Electrical Job</h3>

    <form asp-controller="CompanyDashboard" asp-action="CreateJob" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label fw-bold">Job Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Master Electrician for Factory Panel Upgrade" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Location / City</label>
            <input type="text" name="location" class="form-control" placeholder="e.g. Lahore, Punjab" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Budget (PKR / USD)</label>
            <input type="number" step="0.01" name="budget" class="form-control" placeholder="e.g. 50000" required />
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Job Description & Scope</label>
            <textarea name="description" class="form-control" rows="5" placeholder="Provide detailed requirements, specifications, and scope of work..." required></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success fw-bold px-4 py-2"><i class="fas fa-paper-plane me-1"></i> Post Job Now</button>
            <a asp-action="Jobs" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
        </div>
    </form>
</div>
