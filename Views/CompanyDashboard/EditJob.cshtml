@model ElectroScanAI.Models.Entities.Job
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Edit Job";
    ViewBag.PageTitle = "Edit Job";
    ViewBag.ActivePage = "Jobs";
}

<div class="card shadow-sm border-0 p-4 rounded-3 max-w-2xl mx-auto">
    <h3 class="fw-bold mb-4"><i class="fas fa-edit text-success me-2"></i>Edit Job Posting</h3>

    <form asp-controller="CompanyDashboard" asp-action="EditJob" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label fw-bold">Job Title</label>
            <input type="text" name="title" value="@Model.Title" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Location</label>
            <input type="text" name="location" value="@Model.Location" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Budget</label>
            <input type="number" step="0.01" name="budget" value="@Model.Budget" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Job Status</label>
            <select name="status" class="form-select">
                <option value="Open" selected="@(Model.Status == ElectroScanAI.Models.Enums.JobStatus.Open)">Open</option>
                <option value="In_Progress" selected="@(Model.Status == ElectroScanAI.Models.Enums.JobStatus.In_Progress)">In Progress</option>
                <option value="Completed" selected="@(Model.Status == ElectroScanAI.Models.Enums.JobStatus.Completed)">Completed</option>
                <option value="Closed" selected="@(Model.Status == ElectroScanAI.Models.Enums.JobStatus.Closed)">Closed</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Job Description</label>
            <textarea name="description" class="form-control" rows="5" required>@Model.Description</textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success fw-bold px-4 py-2"><i class="fas fa-save me-1"></i> Save Changes</button>
            <a asp-action="Jobs" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
        </div>
    </form>
</div>
